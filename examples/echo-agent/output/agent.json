{
  "name": "echo-agent",
  "version": "1.0.0",
  "description": "An example agent that echoes messages with timestamps",
  "url": "http://127.0.0.1:8765",
  "conformanceLevel": 2,
  "environment": "development",
  "provider": {
    "organization": "Agent URI Project"
  },
  "documentationUrl": "https://github.com/agent-uri/agent-uri/tree/main/examples/echo-agent",
  "transport": {
    "endpoint": "http://127.0.0.1:8765",
    "https": "http://127.0.0.1:8765"
  },
  "interactionModel": [
    "agent2agent"
  ],
  "skills": [
    {
      "id": "echo",
      "name": "echo",
      "description": "Echoes back the input message appended with the timestamp",
      "version": "1.0.0",
      "tags": [
        "utility",
        "demo"
      ],
      "input": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "original_message": {
            "type": "string"
          }
        }
      },
      "idempotent": false
    }
  ]
}